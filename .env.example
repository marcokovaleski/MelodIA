# =============================================================================
# Spotify OAuth (PKCE) – MelodIA
# =============================================================================
# No Spotify Developer Dashboard: https://developer.spotify.com/dashboard
# - Crie um app e defina "Redirect URI" exatamente igual ao que o app usa
#   (ex.: http://127.0.0.1:5173/callback — sem barra final)
# - Scopes são configurados no código (src/auth/spotifyPKCE.js → SPOTIFY_SCOPES)
# =============================================================================

# Client ID do app (obrigatório)
VITE_SPOTIFY_CLIENT_ID=your_client_id_here

# Redirect URI (opcional em dev: o app usa http://127.0.0.1:{porta}/callback)
# Use em produção se a URL de callback for diferente (ex.: https://app.com/callback)
# VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback

# =============================================================================
# Configurações do n8n (Webhooks dos Fluxos)
# =============================================================================
# URL pública do n8n exposta via Localtunnel (usada por src/services/n8n.js).
# Após importar os workflows no painel, confira se os paths coincidem com os
# definidos no código: /webhook/melodia e /webhook/melodia-edit
# =============================================================================

# URL base do n8n (obrigatório em produção / com túnel)
VITE_N8N_BASE_URL=https://melodiau.loca.lt

# URLs completas dos webhooks (referência — copie do painel n8n após importar):
# Geração de playlist: https://melodiau.loca.lt/webhook/melodia
# Edição de playlist:  https://melodiau.loca.lt/webhook/melodia-edit

# Timeout (ms) para chamadas ao n8n (workflows de IA costumam levar >15s)
# VITE_N8N_TIMEOUT_MS=120000

# Proxy local de /webhook no Vite (somente em desenvolvimento)
# Aponta o proxy do Vite para o túnel n8n, evitando CORS em dev
# VITE_WEBHOOK_PROXY_TARGET=https://melodiau.loca.lt
