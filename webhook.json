    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendHeaders": true,
        "specifyHeaders": "json",
        "jsonHeaders": "{ \"Content-Type\": \"application/json\" }",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"text\": \"Você é um criador de playlists. Crie um título criativo, curto (máximo 4 palavras) e chamativo para uma playlist com as seguintes características:\\n\\nGênero: {{$json.genero}}\\nHumor: {{$json.humor}}\\nArtistas: {{$json.artistas_exemplo.join(', ')}}\\n\\nRetorne ESTRITAMENTE no formato JSON:\\n{\\\"title\\\": \\\"Nome da Playlist\\\"}\"\n        }\n      ]\n    }\n  ],\n  \"generationConfig\": {\n    \"responseMimeType\": \"application/json\",\n    \"temperature\": 0.7\n  }\n}",
        "options": {}
      },
      "id": "f1b9afe6-3066-4350-9be1-2951111b7662",
      "name": "IA Título",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        2544,
        -928
      ],
      "typeVersion": 4.4,
      "credentials": {
        "httpQueryAuth": {
          "id": "SjWfBJo1gl4O02LS",
          "name": "Google Gemini API"
        }
      }
    },
    {
      "parameters": {
        "functionCode": "const raw = $json.candidates[0].content.parts[0].text;\nconst parsed = JSON.parse(raw);\n\nreturn [{\n  title: parsed.title,\n  genero: $node[\"Processar Intenção\"].json.genero,\n  humor: $node[\"Processar Intenção\"].json.humor,\n  artistas_exemplo: $node[\"Processar Intenção\"].json.artistas_exemplo,\n  spotifyToken: $json.spotifyToken\n}];"
      },
      "id": "f195895d-9a1c-4a7e-aa97-bb8f399ade7e",
      "name": "Extrair Título",
      "type": "n8n-nodes-base.function",
      "position": [
        2752,
        -928
      ],
      "typeVersion": 1
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendHeaders": true,
        "specifyHeaders": "json",
        "jsonHeaders": "{ \"Content-Type\": \"application/json\" }",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"text\": \"Você é um curador musical de elite. O usuário quer uma playlist com as seguintes características:\\n\\nGênero: {{$json.genero}}\\nHumor: {{$json.humor}}\\nArtistas Base: {{$json.artistas_exemplo.join(', ')}}\\n\\nREGRAS DE OURO:\\n1. Sugira EXATAMENTE 20 músicas que se encaixem perfeitamente nessa vibe.\\n2. NUNCA invente músicas. Retorne apenas faixas 100% reais que existem no Spotify.\\n3. Para provar a veracidade, inclua o nome do ÁLBUM de onde a música saiu.\\n\\nRetorne ESTRITAMENTE no formato JSON:\\n{\\\"tracks\\\":[{\\\"artist\\\":\\\"nome\\\",\\\"track\\\":\\\"nome\\\",\\\"album\\\":\\\"nome\\\"}]}\"\n        }\n      ]\n    }\n  ],\n  \"generationConfig\": {\n    \"responseMimeType\": \"application/json\",\n    \"temperature\": 0.3\n  }\n}",
        "options": {}
      },
      "id": "15ebb95e-317c-40c6-b9b2-ef60392ec4d5",
      "name": "IA Músicas",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        2944,
        -928
      ],
      "typeVersion": 4.4,
      "credentials": {
        "httpQueryAuth": {
          "id": "SjWfBJo1gl4O02LS",
          "name": "Google Gemini API"
        }
      }
    },
    {
      "parameters": {
        "functionCode": "const raw = $json.candidates[0].content.parts[0].text;\nconst parsed = JSON.parse(raw);\n\nconst tracks = parsed.tracks || [];\n\nconst result = tracks\n  .map(t => ({\n    artist: t.artist,\n    track: t.track,\n    album: t.album,\n    spotifyToken: $node[\"Extrair Dados\"].json.spotifyToken\n  }))\n  .filter(t => t.artist && t.track);\n\nif (result.length === 0) {\n  throw new Error(\"Nenhuma música válida retornada pela IA\");\n}\n\nreturn result;"
      },
      "id": "582d3d96-705a-4b70-8064-219a6617f0d5",
      "name": "Explodir Tracks",
      "type": "n8n-nodes-base.function",
      "position": [
        3152,
        -928
      ],
      "typeVersion": 1
    },
    {
      "parameters": {
        "url": "={{ `https://api.spotify.com/v1/search?q=${encodeURIComponent($json.track)}%20artist:${encodeURIComponent($json.artist)}&type=track&limit=1` }}",
        "sendHeaders": true,
        "specifyHeaders": "json",
        "jsonHeaders": "={\n  \"Authorization\": \"Bearer {{$json.spotifyToken}}\"\n}",
        "options": {}
      },
      "id": "ad679a3d-99d6-42af-9e6f-8c7e5c4d3bfd",
      "name": "Buscar Spotify",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
