      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "functionCode": "const validTracks = [];\n\n// Faz um loop por todos os itens (músicas) que chegaram\nfor (const item of $input.all()) {\n  const data = item.json;\n\n  // Verifica se o Spotify realmente encontrou a música (se o array tem itens)\n  if (data.tracks?.items?.length > 0) {\n    validTracks.push({\n      json: {\n        uri: data.tracks.items[0].uri,\n        spotifyToken: data.spotifyToken // Mantém o token para o próximo nó\n      }\n    });\n  }\n}\n\n// Retorna apenas as músicas válidas\nreturn validTracks;"
      },
      "id": "83a1cb07-b31e-4e5b-963f-21b5e6809a56",
